PORT = 4002
JWT_SECRET="jwt_secret"
DATABASE_URL="postgresql://auth_db:auth_db_password@postgres:5432/auth_db"

SPOTIFY_CLIENT_ID="example"
SPOTIFY_CLIENT_SECRET="example"
SPOTIFY_REDIRECT_URI="https://127.0.0.1:8443/api/auth/spotify/callback"

FRONTEND_URL="https://127.0.0.1:8443"

COOKIE_SECURE="true"
COOKIE_SAMESITE="lax"

# Used to encrypt Spotify user tokens at rest (falls back to JWT_SECRET if unset).
TOKEN_ENCRYPTION_KEY="change-me-spotify-token-key"
