# srcs/backend/playlist-service/.env
# -----------------------------
# Environment / service
NODE_ENV=development
SERVICE_NAME=playlist-service

# Port (internal + mapped by docker compose)
PORT=4004
PLAYLIST_SERVICE_PORT=4004

# Redis (if you later need caching / session storage)
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=info

# CORS / security (optional)
# If you want to restrict origins in dev, set here (comma separated)
ALLOWED_ORIGINS=*

# Optional: Proxy / internal URLs if needed
# AUTH_SERVICE_URL=http://auth-service:4002
# CONTENT_SERVICE_URL=http://content-service:4003

# Notes:
# - Copy this file to ".env" and fill OPENAI_API_KEY with your real key.
# - DO NOT commit your real .env to the repository.