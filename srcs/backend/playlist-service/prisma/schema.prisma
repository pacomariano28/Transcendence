generator client {
  provider = "prisma-client-js"
}

generator zod {
    provider         = "zod-prisma-types"
    output           = "../src/schemas/generated"
    useMultipleFiles = false
    createInputTypes = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SongStatus {
  pending
  ready
  failed
}

model Song {
  id             String     @id @default(uuid())
  isrc           String     @unique
  fileName       String?    @unique
  spotifyTrackId String?
  title          String?
  artist         String?
  status         SongStatus @default(ready)
  failReason     String?
  source         String     @default("seed")
  used           Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

/// Per-playlist rotation for lobby selections (separate from global Song.used pool).
model PlaylistTrackUsage {
  id          String   @id @default(uuid())
  playlistKey String
  isrc        String
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([playlistKey, isrc])
  @@index([playlistKey, used])
}
