generator client {
  provider = "prisma-client-js"
}

//Zod here actually is not necesary YET, but if the admin will want to change
// the songs in the data base, i.e. this service will be reached by the client
// through PUT, DELETE, etc.
//Zod generator block:
generator zod {
  provider         = "zod-prisma-types"
  output           = "../src/schemas/generated" // Indicate where Prisma has to put files.
  useMultipleFiles = false                      // Gather all in one file, not multiple ones.
  createInputTypes = true                       // Create shemas to to create/update 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Song {
  id        String   @id @default(uuid())
  isrc      String
  fileName  String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
